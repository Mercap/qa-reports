              "value": "{\"group\":\"cf-nel\",\"max_age\":604800,\"endpoints\":[{\"url\":\"https://a.nel.cloudflare.com/report/v4?s=tOlJM%2F9sluZ5i00A43YacIfhpIrIvLfg6rEOKzgGd9PoUBpnHT3oZWX6chqDuuP0%2FZJ0%2Fde%2BbZ1yk1f0zKsg7Bv3IPkOGYYq7GiaYRwFigPnqfgqnyRanrP8A61vznloO5Ve6Ab7\"}]}"
