              "value": "{\"group\":\"cf-nel\",\"max_age\":604800,\"endpoints\":[{\"url\":\"https://a.nel.cloudflare.com/report/v4?s=yHaJCmdCVKXMjj6SwOqXhAESB9L%2Brj5dyiaOm6PrfbbXJqVSt6BYTt62ED%2FYgT80%2BZEz2J%2BEqhDCEo0f5umZx0hCwZtO1cGG8%2FTP7QSv57KUIcmx1%2FUYEgsn6q1huzJhj205mEoh\"}]}"
