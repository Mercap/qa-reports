              "value": "{\"group\":\"cf-nel\",\"max_age\":604800,\"endpoints\":[{\"url\":\"https://a.nel.cloudflare.com/report/v4?s=O%2BiHOtpglJ1CotAZMHLNZL2CgKEsUeXnEVyC%2FpFWMKGe5tBSk%2BgHgZLzyNvUDS%2B5LK%2FdrQmZZBXC%2F4VJ%2BBkoBIdI84QRDQr9XqWKed2gOwpowopF4ExNdcTrrx9o%2B5VtiQucfA%3D%3D\"}]}"
