            "text": "/*\r\n* willow-mercap.css v6.1.6\r\n*/\r\n@import url(\"https://fonts.googleapis.com/css?family=Roboto|Roboto+Condensed\");\r\ndiv.application-footer-container\r\n{\r\n\tbackground-color: #0a4d9b;\r\n\tcolor: white;\r\n\tborder-top: solid #0a4d9b 1px;\r\n\tfont-size: 12px;\r\n\theight: 30px;\r\n\tposition: fixed;\r\n\tbottom: 0px;\r\n\tmargin-bottom: 0px;\r\n\tpadding-top: 5px;\r\n\tpadding-bottom: 5px;\r\n\tleft: 0px;\r\n\twidth: 100%;\r\n\tz-index: 999;\r\n}\r\n\r\nul.application-footer-links\r\n{\r\n\tlist-style: none;\r\n\tpadding-left: 10px;\r\n}\r\n\r\nli.application-footer-link\r\n{\r\n\tdisplay: inline-block;\r\n\tpadding-right: 10px;\r\n\tvertical-align: middle;\r\n}\r\n\r\nimg.application-footer-logo-symbol\r\n{\r\n\theight: 19px;\r\n\tmargin-right: 4px;\r\n}\r\n\r\ndiv.row.heading .breadcrumb\r\n{\r\n\tmargin-bottom: inherit;\r\n\tbackground-color: inherit;\r\n}\r\n\r\ntable.table tbody td a.btn-link.btn-xs\r\n{\r\n\tpadding-top: 0;\r\n\tborder-top-width: 0;\r\n}\r\n\r\ndiv.currency-measurement.form-group + div.form-group input.form-control\r\n{\r\n\tz-index: 0;\r\n}\r\n\r\ndiv.currency-measurement div.bootstrap-select > button\r\n{\r\n\tborder-left: 0;\r\n}\r\n\r\ndiv.scrollYWith0Filters div.dataTables_scrollBody\r\n{\r\n\tmax-height: calc(100vh - 310px - 0px);\r\n}\r\n\r\ndiv.modal-content div.scrollYWith0Filters div.dataTables_scrollBody\r\n{\r\n\tmax-height: 30rem !important;\r\n}\r\n\r\ndiv.scrollYWith1Filters div.dataTables_scrollBody\r\n{\r\n\tmax-height: calc(100vh - 310px - 47px);\r\n}\r\n\r\ndiv.modal-content div.scrollYWith1Filters div.dataTables_scrollBody\r\n{\r\n\tmax-height: 30rem !important;\r\n}\r\n\r\ndiv.scrollYWith2Filters div.dataTables_scrollBody\r\n{\r\n\tmax-height: calc(100vh - 310px - 94px);\r\n}\r\n\r\ndiv.modal-content div.scrollYWith2Filters div.dataTables_scrollBody\r\n{\r\n\tmax-height: 30rem !important;\r\n}\r\n\r\ndiv.scrollYWith3Filters div.dataTables_scrollBody\r\n{\r\n\tmax-height: calc(100vh - 310px - 141px);\r\n}\r\n\r\ndiv.modal-content div.scrollYWith3Filters div.dataTables_scrollBody\r\n{\r\n\tmax-height: 30rem !important;\r\n}\r\n\r\ndiv.scrollYWith4Filters div.dataTables_scrollBody\r\n{\r\n\tmax-height: calc(100vh - 310px - 188px);\r\n}\r\n\r\ndiv.modal-content div.scrollYWith4Filters div.dataTables_scrollBody\r\n{\r\n\tmax-height: 30rem !important;\r\n}\r\n\r\ndiv.scrollYWith5Filters div.dataTables_scrollBody\r\n{\r\n\tmax-height: calc(100vh - 310px - 235px);\r\n}\r\n\r\ndiv.modal-content div.scrollYWith5Filters div.dataTables_scrollBody\r\n{\r\n\tmax-height: 30rem !important;\r\n}\r\n\r\ndiv.scrollYWithoutFilters div.dataTables_scrollBody\r\n{\r\n\tmax-height: 74vh;\r\n}\r\n\r\ndiv.willow-fading-notification\r\n{\r\n\theight: 150px;\r\n\tposition: fixed;\r\n\ttop: 30%;\r\n\tleft: 50%;\r\n\tz-index: 1050;\r\n\twidth: 560px;\r\n\ttext-align: center;\r\n\tmargin-left: -280px;\r\n\tborder: 1px solid transparent;\r\n\tborder-radius: 4px;\r\n}\r\n\r\ndiv.willow-fading-notification strong\r\n{\r\n\tfont-size: 16pt;\r\n\tvertical-align: middle;\r\n\tposition: relative;\r\n\ttop: 25%;\r\n}\r\n\r\n.highlighted-negative\r\n{\r\n\tcolor: red;\r\n}\r\n\r\ndiv.small-date-interval-dash::after\r\n{\r\n\tcontent: \"-\";\r\n\tposition: absolute;\r\n\tright: -3px;\r\n\ttop: 4px;\r\n\tvertical-align: middle;\r\n}\r\n\r\ndiv.date-interval-dash::after\r\n{\r\n\tcontent: \"-\";\r\n\tposition: absolute;\r\n\tright: -3px;\r\n\ttop: 9px;\r\n\tvertical-align: middle;\r\n}\r\n\r\ndiv.loading-container\r\n{\r\n\tmargin-top: 20%;\r\n\tmargin-left: 50%;\r\n}\r\n\r\ndiv.loading-overlay\r\n{\r\n\tbackground-color: grey;\r\n\tdisplay: block;\r\n\tposition: fixed;\r\n\ttop: 0px;\r\n\tright: 0px;\r\n\tbottom: 0px;\r\n\tleft: 0px;\r\n\topacity: 0.5;\r\n\tz-index: 9999;\r\n}\r\n\r\n.row.metrics\r\n{\r\n\tborder-top: solid #d57c00 3px;\r\n\tbackground-color: #fff;\r\n\tmargin-bottom: 20px;\r\n\tbox-shadow: 0px 10px 5px -5px rgba(0,0,0,0.15);\r\n}\r\n\r\ndiv.metric\r\n{\r\n\ttext-align: center;\r\n\tfont-weight: bold;\r\n\tpadding: 5px;\r\n}\r\n\r\ndiv.metric > strong.lead\r\n{\r\n\tfont-size: 300%;\r\n\tcolor: #d57c00;\r\n}\r\n\r\ndiv.metric > small\r\n{\r\n\tfont-size: 200%;\r\n\tcolor: #d57c00;\r\n}\r\n\r\ndiv.metric > span.metric-label\r\n{\r\n\tpadding-right: 5px;\r\n}\r\n\r\ndiv.metric > span.metric-unit\r\n{\r\n\tpadding-left: 5px;\r\n}\r\n\r\ndiv.row.metrics > div\r\n{\r\n\tborder-right-color: #d1d1d1;\r\n\tborder-right-style: solid;\r\n\tborder-right-width: 1px;\r\n}\r\n\r\ndiv.row.metrics > div:last-child\r\n{\r\n\tborder-right: inherit;\r\n}\r\n\r\ndiv.modal-xl\r\n{\r\n\twidth: 90%;\r\n}\r\n\r\ndiv.navigation-content\r\n{\r\n\tmax-height: 70vh;\r\n\toverflow-y: auto;\r\n}\r\n\r\n.navigation-sidebar\r\n{\r\n\tpadding-left: 20px;\r\n\tmargin-top: 20px;\r\n\tmargin-bottom: 20px;\r\n}\r\n\r\n.navigation-sidebar .nav > li > a\r\n{\r\n\tborder-left: 4px solid transparent;\r\n\tpadding: 4px 20px;\r\n\tfont-weight: 400;\r\n\tborder-radius: 0;\r\n}\r\n\r\n.navigation-sidebar .nav > li > a:hover ,\r\n.navigation-sidebar .nav > li > a:focus\r\n{\r\n\ttext-decoration: none;\r\n\tbackground-color: transparent;\r\n\tborder-left-color: #3867ac;\r\n}\r\n\r\ntable td div.btn-group\r\n{\r\n\tdisplay: inline-flex;\r\n}\r\n\r\n.number-cell\r\n{\r\n\ttext-align: right !important;\r\n\tfont-variant-numeric: tabular-nums;\r\n}\r\n\r\n.optional-query-filter-close-button\r\n{\r\n\tfont-weight: bold;\r\n\tcolor: #777;\r\n\tmargin-left: 3px !important;\r\n}\r\n\r\n.optional-query-filter-close-button:hover\r\n{\r\n\tbackground-color: #d9534f;\r\n\tborder-color: #d9534f;\r\n\tcolor: white;\r\n}\r\n\r\nbutton.optional-toggle\r\n{\r\n\tbackground-color: #eee;\r\n\tborder-color: #ccc;\r\n}\r\n\r\ndiv.outdated-value::after ,\r\nstrong.outdated-value::after\r\n{\r\n\tcontent: \" *\";\r\n}\r\n\r\n.panel > .panel-heading\r\n{\r\n\ttext-transform: uppercase;\r\n}\r\n\r\ndiv.query-filter-action div.row:last-of-type div.form-group\r\n{\r\n\tmargin-bottom: 0;\r\n}\r\n\r\n@media all and (min-width: 768px)\r\n{\r\n\tdiv.search-bar\r\n\t{\r\n\t\tmin-width: 500px;\r\n\t}\r\n}\r\n\r\n.menu-content * a.btn-block\r\n{\r\n\ttext-transform: uppercase;\r\n}\r\n\r\n.side-navigation-button-without-icon\r\n{\r\n\tmargin-left: 21px;\r\n}\r\n\r\ndiv.single-metric\r\n{\r\n\ttext-align: center;\r\n\tfont-weight: bold;\r\n}\r\n\r\ndiv.single-metric > strong.lead\r\n{\r\n\tfont-size: 200%;\r\n}\r\n\r\ndiv.single-metric > span.single-metric-label\r\n{\r\n\tfont-weight: normal;\r\n\tpadding-right: 5px;\r\n}\r\n\r\ndiv.single-metric > .full-metric-title\r\n{\r\n\tfont-size: 400%;\r\n\tline-height: 1.1;\r\n\tcolor: #d57c00;\r\n}\r\n\r\n.text-overflow-ellipsis > .btn\r\n{\r\n\twhite-space: nowrap;\r\n\toverflow: hidden;\r\n\ttext-overflow: ellipsis;\r\n}\r\n\r\ndiv.tour\r\n{\r\n\twidth: 104px;\r\n\tposition: fixed;\r\n\tright: 0px;\r\n\ttop: 40%;\r\n\tz-index: 1000;\r\n\tmargin-right: -40px;\r\n\ttransform: rotate(-90deg);\r\n\t-moz-transform: rotate(-90deg);\r\n\t-webkit-transform: rotate(-90deg);\r\n\t-o-transform: rotate(-90deg);\r\n\t-ms-transform: rotate(-90deg);\r\n}\r\n\r\nbutton.tour\r\n{\r\n\tdisplay: block;\r\n\tbackground: orange;\r\n\theight: 30px;\r\n\tpadding: 8px 12px;\r\n\tcolor: white;\r\n\tfont-family: Arial;\r\n\tfont-size: 12px;\r\n\tfont-weight: bold;\r\n\ttext-decoration: none;\r\n\ttext-align: center;\r\n}\r\n\r\n.typeahead-loading\r\n{\r\n\tbackground-color: white;\r\n\tbackground-image: url(\"http://cdn.mercap.net/im-cdn/ironman/willow-mercap-6.1.6/typeahead-loading.gif\");\r\n\tbackground-size: 25px 25px;\r\n\tbackground-position: calc(100% - 5px) 4px;\r\n\tbackground-repeat: no-repeat;\r\n}\r\n\r\ndiv.unexpected-error.show\r\n{\r\n\tz-index: 99999;\r\n}\r\n\r\ndiv.unexpected-error fieldset > legend\r\n{\r\n\tfont-size: 14px;\r\n\tfont-weight: bold;\r\n\tmargin-bottom: 5px;\r\n}\r\n\r\ndiv.unexpected-error fieldset > span\r\n{\r\n\tfont-size: 11px;\r\n\tword-wrap: break-word;\r\n}\r\n\r\ndiv.unexpected-error div.modal-content div\r\n{\r\n\tpadding: 10px;\r\n}\r\n\r\ndiv.unexpected-error h4.modal-title\r\n{\r\n\tcolor: #b94a48;\r\n}\r\n\r\ndiv.user-profile\r\n{\r\n\tmin-width: 320px;\r\n}"
