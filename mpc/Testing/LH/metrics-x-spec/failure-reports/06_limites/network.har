            "text": "/*\r\n* sidenavigation.css v1.1.0\r\n*/\r\nimg.brand-symbol\r\n{\r\n\theight: 30px;\r\n\tdisplay: inline;\r\n\tmargin: 10px;\r\n}\r\n\r\n.sidenav > .brand\r\n{\r\n\tbackground-color: #3b4752;\r\n\tmin-height: 50px;\r\n}\r\n\r\n@media all and (min-width: 767px)\r\n{\r\n\t.sidenav.condensed-navigation-sidebar .menu-list .menu-content.collapse a.panel-title strong ,\r\n\t.sidenav.condensed-navigation-sidebar .menu-list .menu-content.collapse h4.panel-title strong ,\r\n\t.sidenav.condensed-navigation-sidebar .menu-list .menu-content.collapse a.panel-title span.badge.pull-right ,\r\n\t.sidenav.condensed-navigation-sidebar .menu-list .menu-content.collapse a.btn-link\r\n\t{\r\n\t\tdisplay: none;\r\n\t}\r\n\t\r\n\t.sidenav.condensed-navigation-sidebar .menu-list .menu-content div.panel-collapse\r\n\t{\r\n\t\taria-expanded: false;\r\n\t}\r\n}\r\n\r\n.menu-content * .panel\r\n{\r\n\tborder-bottom: none;\r\n\tbackground-color: inherit;\r\n\tmargin-bottom: inherit;\r\n\tbox-shadow: inherit;\r\n}\r\n\r\n.menu-content * a.btn\r\n{\r\n\ttext-align: inherit;\r\n}\r\n\r\n.sidenav .container-fluid\r\n{\r\n\tpadding-left: 0;\r\n\tpadding-right: 0;\r\n}\r\n\r\n.sidenav .panel-heading\r\n{\r\n\tpadding-left: 0;\r\n}\r\n\r\n.sidenav .btn:focus ,\r\n.sidenav .btn:hover ,\r\n.sidenav .btn.focus\r\n{\r\n\tcolor: inherit;\r\n}\r\n\r\n.sidenav * img.application-footer-logo-symbol\r\n{\r\n\theight: 16px;\r\n\tmargin-left: 10px;\r\n\tmargin-right: 10px;\r\n}\r\n\r\n.sidenav .panel-heading\r\n{\r\n\tcursor: pointer;\r\n}\r\n\r\ndiv.sidenav-footer\r\n{\r\n\tposition: fixed;\r\n\tbottom: 0px;\r\n\twidth: 17rem;\r\n\tpadding-top: 0.4em;\r\n}\r\n\r\ndiv.sidenav-footer .row\r\n{\r\n\tmargin-left: 0;\r\n\tmargin-right: 0;\r\n}\r\n\r\n.sidenav.navbar-inverse\r\n{\r\n\tborder-radius: 0;\r\n}\r\n\r\n.sidenav li\r\n{\r\n\tpadding-left: 0px;\r\n\tborder-left: 4px solid transparent;\r\n}\r\n\r\n.sidenav li:not(:last-child)\r\n{\r\n\tborder-bottom: 1px outset #8c9399;\r\n}\r\n\r\n.sidenav li:hover\r\n{\r\n\tborder-left: 4px solid #d19b3d;\r\n\ttransition: all 1s ease;\r\n\t-moz-transition: all 1s ease;\r\n\t-webkit-transition: all 1s ease;\r\n\t-o-transition: all 1s ease;\r\n\t-ms-transition: all 1s ease;\r\n}\r\n\r\n.sidenav li:empty\r\n{\r\n\tdisplay: none;\r\n}\r\n\r\n.sidenav\r\n{\r\n\toverflow-y: auto;\r\n\toverflow-x: hidden;\r\n\tbackground-color: #2e353d;\r\n\tfont-weight: 200;\r\n\tposition: fixed;\r\n\ttop: 0px;\r\n\twidth: 17rem;\r\n\theight: 100%;\r\n\tcolor: #ffffff;\r\n}\r\n\r\n@media all and (min-width: 767px)\r\n{\r\n\t.condensed-navigation-sidebar\r\n\t{\r\n\t\twidth: 50px !important;\r\n\t}\r\n}\r\n\r\n.sidenav .navbar-toggle\r\n{\r\n\tdisplay: none;\r\n}\r\n\r\n.sidenav ul ,\r\n.sidenav li\r\n{\r\n\tlist-style: none;\r\n\tpadding: 0px;\r\n\tmargin: 0px;\r\n\tline-height: 35px;\r\n}\r\n\r\n.sidenav ul .active ,\r\n.sidenav li .active\r\n{\r\n\tborder-left: 3px solid #d19b3d;\r\n\tbackground-color: #4f5b69;\r\n}\r\n\r\n.sidenav li a i\r\n{\r\n\tpadding-left: 10px;\r\n\twidth: 20px;\r\n\tpadding-right: 20px;\r\n}\r\n\r\n@media all and (max-width: 767px)\r\n{\r\n\t.sidenav\r\n\t{\r\n\t\tposition: relative;\r\n\t\twidth: 100%;\r\n\t\tmargin-bottom: 10px;\r\n\t}\r\n\t\r\n\t.sidenav .navbar-toggle\r\n\t{\r\n\t\tdisplay: block;\r\n\t\tcursor: pointer;\r\n\t\tposition: absolute;\r\n\t\tright: 10px;\r\n\t\ttop: 0px;\r\n\t\tz-index: 10 !important;\r\n\t\tcolor: #000;\r\n\t\ttext-align: center;\r\n\t\tborder-color: #333;\r\n\t}\r\n}\r\n\r\n@media all and (min-width: 767px)\r\n{\r\n\t.sidenav .menu-list .menu-content\r\n\t{\r\n\t\tdisplay: block;\r\n\t}\r\n\t\r\n\tdiv .layout-container\r\n\t{\r\n\t\tmargin-left: 300px;\r\n\t}\r\n}\r\n\r\n@media all and (min-width: 767px)\r\n{\r\n\t.expanded-container\r\n\t{\r\n\t\tmargin-left: 50px !important;\r\n\t}\r\n}"
