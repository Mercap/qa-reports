            "text": "function formatDecimalWithSeparators(number,decimalPlaces,decimalSeparator,thousandsSeparator){\r\n\t/*\r\n\t * extracting the absolute value of the integer part of the number and converting to string\r\n\t * according to [http://stackoverflow.com/questions/1685680/how-to-avoid-scientific-notation-for-large-numbers-in-javascript]\r\n\t * for numbers greaters than 1e21 the function toFixed() returns a number in scientific notation, and has a maximum precision of 20\r\n\t * thus the need to convert explicitly big ints to the standard notation, but using native javascript we have some limitations \r\n\t * such as: 1111111111111088888888888889 / Math.pow(10,7) == 111111111111108890000. To handle big numbers it is recommended to use specialized libraries. \r\n\t */\r\n\tfunction toStandardNotationAsString(number) {\r\n\t\tif (Math.abs(number) < 1e21) {\r\n\t\t\treturn parseInt(number) + \"\";\r\n\t\t} else {\r\n\t\t\tvar e = parseInt(number.toString().split(\"+\")[1]);\r\n\t\t\tif (e > 20) {\r\n\t\t\t\te -= 20;\r\n\t\t\t\tnumber /= Math.pow(10, e);\r\n\t\t\t\tnumber += (new Array(e + 1)).join(\"0\");\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn number;\r\n\t}\r\n\r\n\t//http://stackoverflow.com/questions/149055/how-can-i-format-numbers-as-money-in-javascript\r\n\t//decimalSeparator: character used as decimal separtor, it defaults to \".\" when omitted\r\n\t//thousandsSeparator: char used as thousands separator, it defaults to \",\" when omitted\r\n\tvar n = number,\r\n\t\tc = isNaN(decimalPlaces) ? 2 : Math.abs(decimalPlaces), //if decimalPlaces is zero we must take it, it means user does not want to show any decimal\r\n\t\td = decimalSeparator || \".\", //if no decimal separator is passed we use the dot as default decimal separator (we MUST use a decimal separator)\r\n\r\n\t\t/*\r\n\t\taccording to [http://stackoverflow.com/questions/411352/how-best-to-determine-if-an-argument-is-not-sent-to-the-javascript-function]\r\n\t\tthe fastest way to check for not defined parameter is to use typeof value === \"undefined\" \r\n\t\trather than doing value === undefined.\r\n\t\tchanged this because of comment in this thread: http://stackoverflow.com/questions/12628068/why-does-jslint-tell-me-to-use-undefined-instead-of-typeof-undef\r\n\t\t*/\r\n\t\tt = (thousandsSeparator === undefined ? \",\" : thousandsSeparator), //if you dont want to use a thousands separator you can pass empty string as thousandsSeparator value\r\n\r\n\t\tsign = (n < 0) ? \"-\" : \"\",\r\n\r\n\t\ti = toStandardNotationAsString(n = Math.abs(n).toFixed(c)),\r\n\r\n\t\tj = ((j = i.length) > 3) ? j % 3 : 0;\r\n\treturn sign + (j ? i.substr(0, j) + t : \"\") + i.substr(j).replace(/(\\d{3})(?=\\d)/g, \"$1\" + t) + (c ? d + Math.abs(n - i).toFixed(c).slice(2) : \"\");\r\n}\r\nfunction formatFloatTo(params){\r\n\t/* Examples\r\n\t * decimalPlaces: 0, suffix: \"%\", scale: 100, descriptionWhenNaN: \"\"\r\n\t *     Will format 0.05 to \"5%\"\r\n\t *     Will format \"\" to \"\"\r\n\t *\r\n\t * decimalPlaces: 4, suffix: \"\", scale: 1, descriptionWhenNaN: undefined (assuming type=\"display\")\r\n\t *     Will format 0.05 to \"0,0500\"\r\n\t *     Will format \"\" to NaN\r\n\t */\r\n\t \r\n\t\"use strict\";\r\n\tconst defaults = {\r\n\t/* @param decimalPlaces\r\n\t* Defines the amount of decimal places to display.\r\n\t* /\r\n\t\t\"decimalPlaces\" : 2,\r\n\t\t\r\n\t /* @param suffix\r\n\t * String to suffix to the formatted number\r\n\t * Ignored when exporting to excel \r\n\t */\r\n\t\t\"suffix\" : \"\",\r\n\t\t\r\n\t /* @param scale\r\n\t * Used to multiply the number before formatting. Useful when working with percentages.\r\n\t * Defaults to 1\r\n\t */\r\n\t\t\"scale\" : 1, \r\n\t\t\r\n\t /* @param descriptionWhenNaN\r\n\t * Defines what to display when the argument is not a number.\r\n\t * Defaults to NaN (Float representing Not A Number)\r\n\t */\r\n\t\t\"descriptionWhenNaN\" : undefined, \r\n\t\t\r\n\t\t\"decimalSeparator\" : \",\", \r\n\t\t\"thousandsSeparator\" : \".\"\r\n\t }\r\n\t\r\n\t// Set defaults\r\n\tconst _params = { ...defaults, ...params }; \r\n\t\r\n\treturn function( number, type ) {\r\n\t\tif( isNaN(number) ) {\r\n\t\t\treturn _params.descriptionWhenNaN === undefined ? number : _params.descriptionWhenNaN;\r\n\t\t}\r\n\t\t\r\n\t\ttype = type || \"display\";\r\n\t\tvar decimalSeparator = null, thousandsSeparator = null;\r\n\t\tswitch( type ) {\r\n\t\t\tcase \"display\":\r\n\t\t\t\tdecimalSeparator = _params.decimalSeparator;\r\n\t\t\t\tthousandsSeparator = _params.thousandsSeparator;\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"excel\":\r\n\t\t\t\tdecimalSeparator = \".\";\r\n\t\t\t\tthousandsSeparator = \",\";\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"copy\":\r\n\t\t\t\tdecimalSeparator = \",\";\r\n\t\t\t\tthousandsSeparator = \".\";\r\n\t\t\t\tbreak;\r\n\t\t\tdefault:\r\n\t\t\t\treturn number;\r\n\t\t}\r\n\t\treturn formatDecimalWithSeparators(number * _params.scale, _params.decimalPlaces, decimalSeparator, thousandsSeparator) + _params.suffix;\r\n\t};\r\n}\r\nfunction functionDoNotHide(indexes){return function(index){return indexes.indexOf(index)===-1;}}\r\nfunction functionFindSelectedRowIds(table){return $(table).find(\"tr.selected\").toArray().map(function(tr) { return tr.id; });}\r\nfunction functionHighlightAllNumbers(td,cellData,rowData,row,col){if ( !isNaN(cellData) ) { $(td).css(\"color\", \"red\"); } }\r\nfunction functionHighlightNegativeAndPositiveNumbers(td,cellData,rowData,row,col){if ( cellData > 0 ) { $(td).addClass(\"text-success\"); } if ( cellData == 0 ) { $(td).addClass(\"text-muted\"); } if ( cellData < 0 ) { $(td).addClass(\"text-danger\"); } }\r\nfunction functionHighlightNegativeNumbers(td,cellData,rowData,row,col){if ( cellData < 0 ) { $(td).addClass(\"highlighted-negative\"); } }\r\nfunction functionIsSpanishDate(string){return string.match(/^(0[1-9]|[12][0-9]|3[01])\\/(0[1-9]|1[012])\\/(19|20|21)\\d\\d$/)}\r\nfunction functionRenderExcelString(data,type){if( type === \"excel\" ) {\r\n\t\treturn  \"'\"+ 