            "mimeType": "text/javascript",
            "compression": 1729,
            "text": "function functionBuildGroupHeaderHTML(rows,group,level,aggregationByLevel,startCollapsed){\r\n// Idea taken from the thread https://datatables.net/forums/discussion/62845/datatables-rowgroup-multi-level-collapse-expand\r\ngroupParent[level] = group;\r\nvar groupUniqueId = \"\"; // built with parent groups\r\nfor (var i = 0; i < level; i++) { \r\n\tgroupUniqueId += groupParent[i]; \r\n\t// if any parent collapsed, render nothing\r\n\tif (collapsedGroups[groupUniqueId]) return;\r\n}\r\ngroupUniqueId += group;\r\n\r\nif ((collapsedGroups[groupUniqueId] === undefined) || (collapsedGroups[groupUniqueId] === null)) \r\n\tcollapsedGroups[groupUniqueId] = startCollapsed === undefined? false : startCollapsed; // true -> start collapsed. false -> start expanded.\r\nvar collapsed = !!collapsedGroups[groupUniqueId];\r\n\r\nrows.nodes().each( r => r.style.display = collapsed ? \"none\" : \"\" );\r\n\r\nconst groupHeadingCell = $('<th class=\"dtrg-group dtrg-start dtrg-level-'+level+'\">'+ group + '</th>');\r\nif( collapsed ) groupHeadingCell.addClass( \"collapsed-group\" );\r\ngroupHeadingCell.attr(\"data-group-id\", groupUniqueId);\r\ngroupHeadingCell.on( \"click\", function() { \r\n\t$(this).toggleClass( \"collapsed-group\" );\r\n\tvar name = $(this).data(\"group-id\");\r\n\tcollapsedGroups[name] = !collapsedGroups[name];\r\n\trows.draw(false);\r\n} );\r\nconst html = $(\"<tr/>\"); \r\nhtml.toggleClass(\"hidden\", collapsed);\r\nhtml.append(groupHeadingCell);\r\n\r\nrows.columns()[0].map( columnIndex => { \r\n\tif( columnIndex == 0 || !rows.column(columnIndex).visible() )\r\n\t\treturn; \r\n\tconst key = \"column\"+columnIndex+\"-level\"+level; \r\n\tconst columnDefinition = rows.context[0].aoColumns[columnIndex];\r\n\tconst dataToConsider = [];\r\n\t// rows is not a collection but some datatables structure, don't use a => function here because it won't work\r\n\trows.every(function(index, tableLoop, rowLoop) {\r\n\t\t  if (!$(this.node()).hasClass(\"ignore-in-group-agreggation\")) {\r\n\t\t\tdataToConsider.push(this.data())\r\n\t\t  }});\r\n\tconst unformattedCellContent = aggregationByLevel.hasOwnProperty(key) ?  aggregationByLevel[key](dataToConsider, columnIndex) : undefined;\r\n\tconst cellContent = unformattedCellContent === undefined ? \"\" : columnDefinition.render( unformattedCellContent );\r\n\tconst cell = $(\"<th>\" + cellContent + \"</th>\");\r\n\t// apply the createCell callback defined for the column to the newly created th\r\n\tif( columnDefinition.hasOwnProperty(\"createdCell\") ) columnDefinition.createdCell( cell, unformattedCellContent, undefined, undefined, undefined ) ;\r\n\t// apply the styles of the column to the newly created th\r\n\tcell.addClass( columnDefinition.sClass );\r\n\tif( !rows.column(columnIndex).visible() ) cell.addClass(\"hidden\");\r\n\thtml.append( cell )\r\n});\r\nreturn html}\r\nfunction functionSumAllIgnoringUndefined(dataToProcess,targetColumn){\r\n\tvar sum = 0,\r\n\tvalue = 0,\r\n\tvalues = dataToProcess.map(e=> e[targetColumn]);\r\n\tfor (index=0;index<values.length;index++) {\r\n\t\tvalue = parseFloat(values[index]);\r\n\t\tsum += (isNaN(value) ? 0 : value);\r\n\t}\r\n\treturn sum;}\r\n"
