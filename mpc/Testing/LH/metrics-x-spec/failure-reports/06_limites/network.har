nToFormatDate(from,to,locale){return $.fn.dataTable.render.moment(from,to,locale)}\r\nfunction functionVisibleColumnNames(currentDataTable,actionColumnClass){\r\n\tvisibleColumnNames = new Array();\r\n\r\n\tvar columns = currentDataTable.settings()[0].aoColumns;\r\n\t$(columns).each(function(columnIndex){\r\n\t\tvar column = columns[columnIndex];\t\t\r\n\t\tif(column.bVisible ){\r\n\t\t\tvisibleColumnNames = visibleColumnNames.concat(column.sName)\r\n\t\t}\r\n\t});\r\n\t\r\n\treturn visibleColumnNames;}\r\n\r\nfunction ascSort(x,y) {\r\n\treturn (x < y) ? -1 : ((x > y) ? 1 : 0);\r\n}\r\nfunction descSort(x,y) {\r\n\treturn -1*ascSort(x,y) ;\r\n}\r\n\r\njQuery.extend( jQuery.fn.dataTable.ext.oSort, {\r\n\t\"numberSortingWithUndefinedSupport-pre\": function ( a ) {\r\n\t\treturn (a === \"N/A\") ? Infinity : parseFloat(a);\r\n\t},\r\n\t\"numberSortingWithUndefinedSupport-asc\": ascSort,\r\n\t\"numberSortingWithUndefinedSupport-desc\":descSort,\r\n\t\r\n\t\"spanishDate-pre\": function ( a ) {\r\n\t\tvar ukDatea = a.split(\"/\");\r\n\t\treturn (ukDatea[2] + ukDatea[1] + ukDatea[0]) * 1;\r\n\t},\r\n\t\r\n\t\"spanishDate-asc\": ascSort,\r\n\t\"spanishDate-desc\": descSort,\r\n\r\n\t\"spanishCharacters-asc\": function(x,y) {\r\n\t\treturn x.localeCompare(y);\r\n\t},\r\n\t\"spanishCharacters-desc\": function(x,y) {\r\n\t\treturn -(x.localeCompare(y));\r\n\t},\r\n\t\r\n\t\"monthOfYear-pre\": function ( a ) {\r\n\t\tvar ukDatea = a.split(\"/\");\r\n\t\treturn (ukDatea[1] + ukDatea[0]) * 1;\r\n\t},\r\n\t\"monthOfYear-asc\": ascSort,\r\n\t\"monthOfYear-desc\": descSort\r\n});\r\njQuery.fn.DataTable.ext.aTypes.unshift(\r\n\tfunction ( sData )\r\n\t{\r\n\t\tif (sData !== null && sData.match(/^(0[1-9]|[12][0-9]|3[01])\\/(0[1-9]|1[012])\\/(19|20|21)\\d\\d$/))\r\n\t\t{\r\n\t\t\treturn \"spanishDate\";\r\n\t\t}\r\n\t\treturn null;\r\n\t},\r\n\tfunction ( sData )\r\n\t{\r\n\t\tif (sData !== null && sData.match(/^(0[1-9]|[12][0-9]|3[01])\\/(0[1-9]|1[012])\\/(19|20|21)\\d\\d ([1-9]|[01]\