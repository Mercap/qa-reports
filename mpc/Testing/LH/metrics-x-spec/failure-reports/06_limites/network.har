            "size": 2172,
            "mimeType": "text/javascript",
            "compression": 1373,
            "text": "function markFieldAsInvalid(elementId,feedback){\r\n\tvar element = $(elementId);\r\n\tvar feedbackElement = feedback ? $(\"<div></div>\").addClass(\"invalid-feedback d-block\").html(feedback) : undefined;\r\n\tif (element.prop('tagName') == 'INPUT') {\r\n\t\telement.addClass('is-invalid');\r\n\t\tif (feedbackElement) feedbackElement.insertAfter(element);\r\n\t} else if (element.prop('tagName') == 'SELECT') {\r\n\t\tif (element.hasClass('selectpicker')) {\r\n\t\t\telement.next().addClass('is-invalid');\r\n\t\t\tif (feedbackElement) feedbackElement.insertAfter(element.next());\r\n\t\t} else {\r\n\t\t\telement.addClass('is-invalid');\r\n\t\t\tif (feedbackElement) feedbackElement.insertAfter(element);\r\n\t\t}\r\n\t} else if (element.prop('tagName') == 'DIV' && element.children('div.input-group').length == 1) {\r\n\t\t// este es para el caso de los PercentageFieldView\r\n\t  element.find(\"input\").addClass('is-invalid');\r\n\t  if( feedbackElement ) feedbackElement.insertAfter( element );\r\n\t} else {\r\n\t\tconsole.log(elementId + ' cant be marked as invalid');\r\n\t\treturn;\r\n\t}}\r\nfunction clearFieldInvalidFeedback(elementId){\r\n\tvar element = $(elementId);\r\n\r\n\tif (element.next().length == 1 && element.next().hasClass(\"invalid-feedback\")) {\r\n\t\telement.next().remove();\r\n\t}\r\n\r\n\tif (element.prop('tagName') == 'INPUT') {\r\n\t\telement.removeClass('is-invalid');\r\n\t} else if (element.prop('tagName') == 'SELECT') {\r\n\t\telement.hasClass('selectpicker') ? element.next().removeClass('is-invalid') : element.removeClass('is-invalid');\r\n\t} else if (element.prop('tagName') == 'DIV' && element.children('div.input-group').length == 1) {\r\n\t\telement.find(\"input\").removeClass('is-invalid');\r\n\t} }\r\nfunction invalidWorkbookFilenameRegex(){return /[^\\w\\s\\-_.()�-�]/gi;}\r\nfunction sumAllForecastPaymentsFunction(dataToProcess,targetColumn){\r\n\tlet sum = 0;\r\n\tdataToProcess.forEach((e) => {\r\n\t\tlet value = e[targetColumn];\r\n\t\t //Chequeo si me llega la etiqueta de hipervinculo y parseo el contenido\r\n\t\tif (value.includes('<a')){\r\n\t\t\tconst valueContent = $(value)[0].innerText;\r\n\t\t\tvalue = valueContent.replace(/\\./g, '').replace(',', '.');}; \r\n\t\tlet parsedValue = parseFloat(value);\r\n\t\tsum += isNaN(parsedValue) ? 0 : parsedValue;\r\n\t});\r\n\treturn sum;}\r\n"
          },
